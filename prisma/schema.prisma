generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  name        String?
  role        String      @default("OWNER")
  createdAt   DateTime    @default(now())
  memorials   Memorial[]  @relation("MemorialOwner")
  approved    Condolence[] @relation("ApprovedBy")
}

model Family {
  id          String      @id @default(cuid())
  name        String
  createdAt   DateTime    @default(now())
  memorials   Memorial[]
}

model Memorial {
  id            String          @id @default(cuid())
  ownerId       String?
  familyId      String?
  name          String
  birthDate     DateTime?
  deathDate     DateTime?
  bio           String?
  photoUrl      String?
  audioUrl      String?
  headstoneType String          @default("classic")
  privacy       String          @default("PUBLIC")
  pinCode       String?
  isPet         Boolean         @default(false)
  positionX     Float           @default(0)
  positionY     Float           @default(0)
  positionZ     Float           @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  owner         User?           @relation("MemorialOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  family        Family?         @relation(fields: [familyId], references: [id], onDelete: SetNull)
  timeline      TimelineEvent[]
  gifts         GiftTransaction[]
  condolences  Condolence[]
  relationsFrom FamilyRelation[] @relation("RelationFrom")
  relationsTo   FamilyRelation[] @relation("RelationTo")

  @@index([positionX, positionZ])
  @@index([familyId])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  memorialId  String
  year        Int
  title       String
  description String
  imageUrl    String?
  memorial    Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId, year])
}

model GiftTransaction {
  id            String   @id @default(cuid())
  memorialId    String
  giftType      String
  stripeSessionId String? @unique
  purchasedAt   DateTime @default(now())
  activeUntil   DateTime
  amount        Int
  currency      String   @default("eur")
  memorial      Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId, activeUntil])
}

model Condolence {
  id          String           @id @default(cuid())
  memorialId  String
  authorName  String
  content     String
  status      String           @default("PENDING")
  approvedById String?
  createdAt   DateTime         @default(now())
  memorial    Memorial         @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  approvedBy  User?            @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([memorialId, status])
}

model FamilyRelation {
  id           String   @id @default(cuid())
  fromMemorialId String
  toMemorialId String
  relationType String
  fromMemorial Memorial @relation("RelationFrom", fields: [fromMemorialId], references: [id], onDelete: Cascade)
  toMemorial   Memorial @relation("RelationTo", fields: [toMemorialId], references: [id], onDelete: Cascade)

  @@unique([fromMemorialId, toMemorialId])
}